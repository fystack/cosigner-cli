# Copy to .env and adjust. Every setting is optional.

# Port the callback server listens on.
PORT=8089

# Folder for key files: server-private.pem (generated on first start),
# server-public.pem (give to the cosigner) and cosigner-public.pem (from the cosigner).
KEY_DIR=./keys

# Server private key as PEM text, instead of keys/server-private.pem.
# Useful when a secret manager injects it. Keep the quotes for multi-line values.
# SERVER_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
# ...
# -----END PRIVATE KEY-----"

# Cosigner public key as PEM text, instead of keys/cosigner-public.pem.
# COSIGNER_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
# ...
# -----END PUBLIC KEY-----"

# Only for the KmsSigner variant in the README.
# KMS_KEY_ID=
